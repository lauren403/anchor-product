# Required for all non-local builds: preview, beta or production.
NEXT_PUBLIC_ANCHOR_ENV=preview
NEXT_PUBLIC_RELEASE_SHA=local-preview

# Required for beta and production. Create a browser JavaScript project in the
# approved monitoring account. Do not enable session replay or user feedback.
NEXT_PUBLIC_SENTRY_DSN=

# Used by scheduled uptime checks in GitHub Actions, not by the application.
PREVIEW_HEALTHCHECK_URL=
BETA_HEALTHCHECK_URL=
PRODUCTION_HEALTHCHECK_URL=
