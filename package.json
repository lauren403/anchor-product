{
  "name": "anchor-v7-ecosystem",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && npm run test:rendered",
    "test:unit": "node --experimental-strip-types --test tests/recommendation.test.mjs tests/integration-contract.test.mjs tests/deployed-asset-check.test.mjs tests/build-node-env.test.mjs",
    "test:rendered": "node --experimental-strip-types --test tests/rendered-html.test.mjs tests/operations.test.mjs tests/endpoint-behaviour.test.mjs tests/accessibility.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:release": "node scripts/validate-release-record.mjs",
    "test:rollback": "bash scripts/test-artifact-rollback.sh",
    "quality": "npm run validate:config -- --environment preview && npm run lint && npm run typecheck && npm test && npm audit --omit=dev --audit-level=high",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.6",
    "@fontsource/fraunces": "5.2.6",
    "@sentry/nextjs": "10.69.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.536.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260831.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.13.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "25.0.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module",
  "displayName": "Anchor v7 Ecosystem Integration",
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
