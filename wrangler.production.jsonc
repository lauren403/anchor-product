{
  // Production / beta deploy config for Anchor v7.
  // Mirrors wrangler.smoke.jsonc but WITHOUT the acceptance-gate wrapper:
  // production serves the app publicly (no Bearer token in front of /api/health).
  // The worker name and environment are set per-deploy via --name / --var flags
  // in .github/workflows/deploy.yml (anchor-beta or anchor-production).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anchor",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // run_worker_first is DELIBERATELY ABSENT. It used to be true here, and
  // wrangler.beta.jsonc still carries a comment claiming production "keeps
  // run_worker_first: true because there the app worker itself is main and
  // serves assets correctly". That claim was never tested, and it is false.
  // The first completed run of deploy.yml (Deploy Anchor #2, 2026-08-23)
  // shipped with it on: /api/health returned a perfect 200 while EVERY
  // /assets/* request returned 503, so no CSS and no JS loaded and the page
  // sat forever on "Finding a gentle place to begin". With the flag off,
  // Cloudflare serves files under dist/client directly and only non-asset
  // paths reach the worker - which is what the gated rehearsal already
  // proved works. Do not put it back.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
  // No d1_databases / r2_buckets: .openai/hosting.json has d1=null, r2=null,
  // so the app ships device-local with no server database (matches README).
  // If server-side storage is added later, provision a D1 database and add a
  // "d1_databases" binding named "DB" here, then run drizzle migrations.
}
