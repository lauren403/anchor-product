{
  // Rehearsal beta deploy config for Anchor v7. Mirrors wrangler.smoke.jsonc but
  // fronts the app with an HTTP Basic password gate (beta/worker.ts) instead of
  // the Bearer acceptance gate. Deploys a throwaway workers.dev worker named
  // anchor-beta-rehearsal — NOT the live site. The password is a secret:
  //   wrangler secret put ANCHOR_BETA_PASSWORD --config wrangler.beta.jsonc
  // (optional ANCHOR_BETA_USER, defaults to "beta"). run_worker_first keeps the
  // gate in front of static assets so nothing bypasses it.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anchor-beta-rehearsal",
  "main": "./beta/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // run_worker_first is intentionally OFF for the gated rehearsal: with a wrapper
  // worker as `main`, routing every request (incl. static assets) through the
  // wrapper causes the app's JS/CSS to 404. With it off, Cloudflare serves
  // /assets/* directly and the wrapper still gates the app's HTML/SSR routes.
  // (Production, wrangler.production.jsonc, keeps run_worker_first: true because
  // there the app worker itself is `main` and serves assets correctly.)
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
